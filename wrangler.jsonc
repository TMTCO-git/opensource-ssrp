{
  "name": "tmtco-ssrp",
  "main": "srv/index.js",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // The SESSIONS binding name must match what index.js uses (env.SESSIONS).
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "29ad9c1d7e7c4a0c9384cd0a1c0ec3e4" }
  ],

  "vars": {
    "TENANT_ID": "f1011f75-0d96-4d08-b8d4-6c79c851f9ba",
    "CLIENT_ID": "2d5ca26b-fd22-4591-a256-7702f6ab7a47",

    // Verified ID settings used by the SSRP
    "VC_AUTHORITY": "did:web:verifiedid.entra.microsoft.com:f1011f75-0d96-4d08-b8d4-6c79c851f9ba:f5674475-f43e-b35b-dcc6-5d3c3efe6441",
    "VC_TYPE": "VerifiedEmployee"
  },

  "observability": {
    "enabled": true,
    "logs": { "enabled": true }
  }

  // SECRETS (set in the dashboard, never in this file):
  //   CLIENT_SECRET
  //   VC_CALLBACK_KEY
}
